# ============================================================================
# PROJECT_FIT — Variables d'environnement (EXEMPLE)
# Copier vers apps/mobile/.env et remplir. NE JAMAIS committer le .env réel.
# Convention Expo : seules les variables préfixées EXPO_PUBLIC_ sont exposées
# au bundle client. N'y mettre QUE des valeurs non sensibles.
# Les vrais secrets (clé IA, RevenueCat secret, service_role) vivent côté
# serveur (Supabase Edge Functions secrets), jamais ici.
# ============================================================================

# --- App ---
EXPO_PUBLIC_APP_ENV=development            # development | staging | production

# --- Supabase (public : anon key est conçue pour être publique + protégée par RLS) ---
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- RevenueCat (clés PUBLIQUES SDK, spécifiques par store — non secrètes) ---
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_XXXXXXXX
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_XXXXXXXX

# --- Analytics (clé projet publique) ---
EXPO_PUBLIC_POSTHOG_KEY=phc_XXXXXXXX
EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# --- Sentry (DSN public) ---
EXPO_PUBLIC_SENTRY_DSN=

# ============================================================================
# SECRETS SERVEUR (NE PAS mettre ici — configurés via `supabase secrets set`) :
#   ANTHROPIC_API_KEY          -> Edge Function /ai/recommendation
#   REVENUECAT_WEBHOOK_SECRET  -> Edge Function /subscriptions/webhook
#   SUPABASE_SERVICE_ROLE_KEY  -> Edge Functions admin/delete (jamais côté client)
# ============================================================================
